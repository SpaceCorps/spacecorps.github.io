# Static site for spacecorps.tech. Listens on :80 inside the container; Sliplane terminates TLS.
# The handle blocks are mutually exclusive and checked in order, so /healthz answers for any host.
{
	auto_https off
	admin off
}

:80 {
	handle /healthz {
		respond "ok" 200
	}

	# Old company domain: redirect to the apex, keeping path and query.
	@oldcompany host spacecorpstechnology.com www.spacecorpstechnology.com
	handle @oldcompany {
		redir https://spacecorps.tech{uri} permanent
	}

	@www host www.spacecorps.tech
	handle @www {
		redir https://spacecorps.tech{uri} permanent
	}

	# The status service (status/ in this repository) is a separate container; STATUS_UPSTREAM is its address
	# (for example https://spacecorps-status.sliplane.app). Without it this path answers 502 and the rest of the site
	# is unaffected: the chart on /status.html then says the history is not available.
	handle /api/status/* {
		reverse_proxy {$STATUS_UPSTREAM:http://127.0.0.1:8090} {
			header_up Host {upstream_hostport}
			transport http {
				dial_timeout 3s
				response_header_timeout 10s
			}
		}
	}

	handle {
		root * /srv
		encode zstd gzip

		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options SAMEORIGIN
		}

		# Markdown and text are served as UTF-8 text for people and agents.
		@text path *.md *.txt
		header @text Content-Type "text/plain; charset=utf-8"
		@md path *.md
		header @md Content-Type "text/markdown; charset=utf-8"

		@fonts path /fonts/*
		header @fonts Cache-Control "public, max-age=31536000, immutable"
		@img path /img/*
		header @img Cache-Control "public, max-age=604800"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@media path /blog/media/*
		header @media Cache-Control "public, max-age=86400"

		file_server {
			precompressed gzip
		}
	}

	handle_errors {
		rewrite * /404.html
		file_server {
			root /srv
		}
	}
}
